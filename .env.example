# Application
APP_NAME="FishFeed API"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT="development"

# Sentry (Error Tracking & Performance Monitoring)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fishfeed"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_POOL_MIN_SIZE=5
REDIS_POOL_MAX_SIZE=20
REDIS_POOL_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=3
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# CORS (comma-separated list of allowed origins; for production add your domain)
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'

# JWT Authentication
JWT_SECRET_KEY="CHANGE-ME-generate-with-openssl-rand-base64-64"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# S3 Storage (Hetzner Object Storage compatible)
# Dev (MinIO): S3_ENDPOINT_URL="http://minio:9000", S3_ACCESS_KEY/S3_SECRET_KEY = minioadmin
S3_ENDPOINT_URL="https://fsn1.your-objectstorage.com"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET_NAME="fishfeed-scans"
S3_IMAGES_BUCKET_NAME="fishfeed-images"
# Species images live in a public bucket served via S3_PUBLIC_CDN_DOMAIN.
S3_SPECIES_BUCKET_NAME="fishfeed-species"
# Public CDN domain mapped to the species bucket (e.g. cdn.fishfeed.club).
# When set, species images are served directly; otherwise presigned URLs are used.
S3_PUBLIC_CDN_DOMAIN=""
S3_REGION="eu-central"
S3_RETENTION_DAYS=30
# Separate endpoint for presigned URLs, accessible outside Docker network.
# Dev: http://localhost:9000 (MinIO port mapped to host). Prod: leave empty (uses S3_ENDPOINT_URL).
S3_PRESIGNED_ENDPOINT_URL="http://localhost:9000"
# Endpoint used when the admin panel generates presigned URLs. Browser-side
# fetch must reach this host — it may differ from S3_PRESIGNED_ENDPOINT_URL
# (which targets the mobile emulator/app). Leave empty to fall back to
# S3_PRESIGNED_ENDPOINT_URL. For an admin served over HTTPS, set this to an
# HTTPS MinIO proxy to avoid mixed-content blocking (e.g. https://cdn.example.com).
S3_ADMIN_PRESIGNED_ENDPOINT_URL=""

# MinIO (local dev only, used by docker-compose)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# FCM (Firebase Cloud Messaging) - Android Push Notifications
FCM_PROJECT_ID="your-firebase-project-id"
FCM_CREDENTIALS_PATH="path/to/firebase-service-account.json"
FCM_DRY_RUN=false

# APNs (Apple Push Notification service) - iOS Push Notifications
APNS_KEY_ID="your-apns-key-id"
APNS_TEAM_ID="your-apple-team-id"
APNS_BUNDLE_ID="com.yourcompany.fishfeed"
APNS_KEY_PATH="path/to/AuthKey.p8"
APNS_USE_SANDBOX=true

# RevenueCat (In-App Purchases)
REVENUECAT_API_KEY="your-revenuecat-api-key"
REVENUECAT_WEBHOOK_SECRET="your-webhook-secret"

# AI Provider
AI_PROVIDER="google_vision"
GOOGLE_CLOUD_PROJECT="your-gcp-project"
GOOGLE_APPLICATION_CREDENTIALS="path/to/gcp-credentials.json"
REPLICATE_API_TOKEN="your-replicate-token"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
APPLE_CLIENT_ID="your-apple-client-id"

# ===========================================
# Production Environment (docker-compose.prod.yml)
# ===========================================

# Required for production deployment
POSTGRES_PASSWORD="your-secure-postgres-password"
API_DOMAIN="api.yourdomain.com"
ADMIN_DOMAIN="admin.yourdomain.com"

# Admin Panel Credentials (for SQLAdmin login at /admin)
# ADMIN_PASSWORD must be an argon2id hash. Generate with:
#   python scripts/hash_admin_password.py 'your-password'
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="$argon2id$v=19$m=65536,t=3,p=4$..."
SESSION_SECRET_KEY="CHANGE-ME-generate-with-openssl-rand-base64-64"
GITHUB_REPOSITORY="owner/fishfeed"
IMAGE_TAG="latest"

# Mobile Releases BasicAuth (generate with: htpasswd -nb tester password123)
RELEASES_BASIC_AUTH=""
